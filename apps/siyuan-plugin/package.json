{
  "name": "sy-another-graph",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --mode development --watch",
    "dev:ui": "vite build --config vite.ui.config.ts --watch",
    "build": "tsc -b && vite build && vite build --config vite.ui.config.ts",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check:plugin": "node scripts/check-plugin.mjs"
  },
  "dependencies": {
    "@cosmograph/cosmograph": "2.5.1",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@tanstack/react-router": "1.170.33",
    "apache-arrow": "17.0.0",
    "lucide-react": "1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "siyuan": "1.2.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "5.0.0"
  }
}
